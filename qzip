#!/usr/bin/env bash
# qzip - create a timestamped zip archive of files and directories
# Date: 2026-11-11
# Version: v0.1.1
# Purpose: bundle the given files and directories into a single timestamped
#          zip archive, optionally checksummed.
set -euo pipefail

prog=${0##*/}

usage() {
  cat <<EOF
Usage: $prog [options] FILE|DIR [FILE|DIR ...]

Create a timestamped zip archive of the given files and directories.
Options may appear before, after, or between file names. Use -- to end
option parsing.

Options:
  -d DIR      output directory (default: /var/tmp)
  -n NAME     name for the archive (default: name of first input)
  -x PATTERN  exclude files matching PATTERN (repeatable)
  -s          also write a SHA-256 checksum file
  -v          verbose output
  -N          dry run: show what would be done
  -h          show this help
EOF
}

die() {
  echo "$prog: $*" >&2
  exit 1
}

dir=/var/tmp
name=
checksum=0
verbose=0
dryrun=0
excludes=()

files=()
end_opts=0
while [[ $# -gt 0 ]]; do
  arg=$1
  shift
  if [[ $end_opts -eq 1 || $arg != -* || $arg == - ]]; then
    files+=("$arg")
    continue
  fi
  case $arg in
    --) end_opts=1 ;;
    --help) usage; exit 0 ;;
    --*) die "unknown option $arg (see -h)" ;;
    -*)
      cluster=${arg#-}
      while [[ -n $cluster ]]; do
        opt=${cluster:0:1}
        cluster=${cluster:1}
        case $opt in
          d|n|x)
            if [[ -n $cluster ]]; then
              val=$cluster
            elif [[ $# -gt 0 ]]; then
              val=$1
              shift
            else
              die "option -$opt requires an argument"
            fi
            cluster=
            case $opt in
              d) dir=$val ;;
              n) name=$val ;;
              x) excludes+=("$val") ;;
            esac
            ;;
          s) checksum=1 ;;
          v) verbose=1 ;;
          N) dryrun=1 ;;
          h) usage; exit 0 ;;
          *) die "unknown option -$opt (see -h)" ;;
        esac
      done
      ;;
  esac
done
set -- ${files[@]+"${files[@]}"}

[[ $# -gt 0 ]] || { usage >&2; exit 1; }
command -v zip >/dev/null || die "zip is not installed"
command -v zipinfo >/dev/null || die "zipinfo is not installed"

inputs=()
for f in "$@"; do
  [[ -e $f ]] || die "no such file or directory: $f"
  [[ $f == -* ]] && f="./$f"
  inputs+=("$f")
done

if [[ -z $name ]]; then
  name=${1%/}
  name=${name##*/}
fi
name=${name//[^A-Za-z0-9._-]/_}
[[ -n $name ]] || name=archive

stamp=$(date +%F_%H-%M)
out="$dir/quickzip-$name-$stamp.zip"

limit=$((500 * 1024 * 1024))
total=$(du -sbc -- "${inputs[@]}" | tail -n 1 | cut -f1)
if [[ $verbose -eq 0 && $total -ge $limit ]]; then
  verbose=1
  echo "Inputs are over 500 MiB, listing files as they are archived"
fi

zip_args=(-9r)
if [[ $verbose -eq 0 ]]; then
  zip_args+=(-q)
fi
zip_args+=("$out" "${inputs[@]}")
if [[ ${#excludes[@]} -gt 0 ]]; then
  zip_args+=(-x "${excludes[@]}")
fi

if [[ $dryrun -eq 1 ]]; then
  echo "Would run: zip ${zip_args[*]}"
  exit 0
fi

mkdir -p -- "$dir"
if ! zip "${zip_args[@]}"; then
  rm -f -- "$out"
  die "zip failed"
fi

base=${out##*/}
if [[ $checksum -eq 1 ]]; then
  (cd -- "$dir" && sha256sum -- "$base" > "$base.sha256")
fi

count=$(zipinfo -1 "$out" | awk '!/\/$/ { n++ } END { print n + 0 }')
size=$(stat -c %s -- "$out")
color=0
if [[ -t 1 ]]; then
  color=1
fi
human=$(awk -v b="$size" -v color="$color" 'BEGIN {
  k = 1024
  if (b >= k^5 * 0.98)      { v = b / k^5; u = "P"; c = 167 }
  else if (b >= k^4 * 0.98) { v = b / k^4; u = "T"; c = 105 }
  else if (b >= k^3 * 0.98) { v = b / k^3; u = "G"; c = 45 }
  else if (b >= k^2 * 0.98) { v = b / k^2; u = "M"; c = 47 }
  else if (b >= k)          { v = b / k;   u = "K"; c = 226 }
  else                      { v = b;       u = "B"; c = 160 }
  if (color) printf "\033[38;5;%dm", c
  if (u == "B") printf "%dB", v
  else printf "%.1f%s", v, u
  if (color) printf "\033[0m"
}')
if [[ $color -eq 1 ]]; then
  count=$'\033[1m\033[97m'"$count files"$'\033[0m'
else
  count="$count files"
fi
echo "$count, $human"
echo "Wrote: $(realpath -- "$out")"

#!/usr/bin/env bash
# qtar - create a timestamped tar archive of files and directories
# Date: 2026-11-11
# Purpose: bundle the given files and directories into a single timestamped
#          tar archive, optionally compressed and checksummed.
set -euo pipefail

version=v0.1.5
prog=${0##*/}

usage() {
  cat <<EOF
Usage: $prog [options] FILE|DIR [FILE|DIR ...]
       $prog FILE|DIR [FILE|DIR ...] -d [-o DIR] [-x PATTERN]

Create a timestamped tar archive of the given files and directories.
Options may appear before, after, or between file names. Use -- to end
option parsing.

Diff mode (--diff): compare each directory with the newest quicktar archive
of that name (searched in the -o directory) and show a unified diff. Exits 1
if any directory differs. Compression, naming, checksum, and -v/-N options are
not used in diff mode.

Options:
  -o DIR      output directory, or archive directory in diff mode (default: /var/tmp)
  -n NAME     name for the archive (default: name of first input)
  -c FORMAT   compression: zst (default)
  -l LEVEL    compression level 1-9
  -x PATTERN  exclude files matching PATTERN (repeatable)
  -s          also write a SHA-256 checksum file
  -v          verbose output
  -N          dry run: show what would be done
  -d, --diff  diff each directory against its most recent archive
  -C, --color always colorize diff output (diff mode only; default: terminal only)
  --version   show version
  -h          show this help
EOF
}

die() {
  echo "$prog: $*" >&2
  exit 1
}

has_gzip=0
has_zstd=0
command -v gzip >/dev/null && has_gzip=1
command -v zstd >/dev/null && has_zstd=1

dir=/var/tmp
name=
if [[ $has_zstd -eq 1 ]]; then
  fmt=zst
else
  fmt=gz
fi
level=
checksum=0
verbose=0
dryrun=0
diff_mode=0
color=auto
fmt_set=0
level_set=0
other_set=0
excludes=()

files=()
end_opts=0
while [[ $# -gt 0 ]]; do
  arg=$1
  shift
  if [[ $end_opts -eq 1 || $arg != -* || $arg == - ]]; then
    files+=("$arg")
    continue
  fi
  case $arg in
    --) end_opts=1 ;;
    --help) usage; exit 0 ;;
    --diff) diff_mode=1 ;;
    --color) color=always ;;
    --version) echo "$prog $version"; exit 0 ;;
    --*) die "unknown option $arg (see -h)" ;;
    -*)
      cluster=${arg#-}
      while [[ -n $cluster ]]; do
        opt=${cluster:0:1}
        cluster=${cluster:1}
        case $opt in
          o|n|c|l|x)
            if [[ -n $cluster ]]; then
              val=$cluster
            elif [[ $# -gt 0 ]]; then
              val=$1
              shift
            else
              die "option -$opt requires an argument"
            fi
            cluster=
            case $opt in
              o) dir=$val ;;
              n) name=$val; other_set=1 ;;
              c) fmt=$val; fmt_set=1 ;;
              l) level=$val; level_set=1 ;;
              x) excludes+=("$val") ;;
            esac
            ;;
          s) checksum=1 ;;
          d) diff_mode=1 ;;
          v) verbose=1; other_set=1 ;;
          N) dryrun=1; other_set=1 ;;
          C) color=always ;;
          h) usage; exit 0 ;;
          *) die "unknown option -$opt (see -h)" ;;
        esac
      done
      ;;
  esac
done
set -- ${files[@]+"${files[@]}"}

[[ $# -gt 0 ]] || { usage >&2; exit 1; }

if [[ $diff_mode -eq 1 ]]; then
  if [[ $fmt_set -eq 1 || $level_set -eq 1 || $other_set -eq 1 ]]; then
    die "-c, -l, -n, -v, and -N cannot be used with --diff"
  fi
  if [[ $checksum -eq 1 ]]; then
    die "-s cannot be used with --diff"
  fi
  tmproot=/tmp/opencode
  [[ -d $tmproot ]] || tmproot=${TMPDIR:-/tmp}
  tmp=$(mktemp -d "$tmproot/qtar.XXXXXX")
  trap 'rm -rf -- "$tmp"' EXIT

  stamp_re='^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{2}-[0-9]{2}$'
  overall=0
  for path in "$@"; do
    [[ -d $path ]] || die "not a directory: $path"

    name=${path%/}
    name=${name##*/}
    [[ -n $name && $name != . && $name != .. ]] || die "cannot determine archive name for: $path"
    name=${name//[^A-Za-z0-9._-]/_}

    candidates=()
    for ext in tar.zst tar.gz tar.xz tar.bz2 tar; do
      for archive in "$dir/quicktar-$name-"*."$ext"; do
        [[ -f $archive ]] || continue
        stamp=${archive##*/quicktar-"$name"-}
        stamp=${stamp%."$ext"}
        [[ $stamp =~ $stamp_re ]] || continue
        candidates+=("$stamp|$ext|$archive")
      done
    done

    [[ ${#candidates[@]} -gt 0 ]] || die "no quicktar archive found for $path in $dir"

    newest=$(printf '%s\n' "${candidates[@]}" | sort -r | head -n 1)
    ext=$(cut -d'|' -f2 <<< "$newest")
    archive=$(cut -d'|' -f3- <<< "$newest")

    case $ext in
      tar.gz) [[ $has_gzip -eq 1 ]] || die "gzip is not installed"; dec=(gzip -dc) ;;
      tar.xz) dec=(xz -dc) ;;
      tar.zst) [[ $has_zstd -eq 1 ]] || die "zstd is not installed"; dec=(zstd -dqc) ;;
      tar.bz2) dec=(bzip2 -dc) ;;
      tar) dec=(cat) ;;
    esac
    command -v "${dec[0]}" >/dev/null || die "${dec[0]} is not installed"

    echo "Comparing $path with $archive"
    extract="$tmp/$name.d"
    mkdir -p -- "$extract"
    "${dec[@]}" -- "$archive" | tar -xf - -C "$extract" || die "failed to extract: $archive"
    [[ -d $extract/$name ]] || die "archive does not contain $name/: $archive"

    status=0
    diff -ruN --color=$color -- "$extract/$name" "$path" || status=$?
    if [[ $status -eq 0 ]]; then
      echo "$path matches $archive"
    else
      overall=1
    fi
    rm -rf -- "$extract"
  done
  exit "$overall"
fi

if [[ $level_set -eq 0 ]]; then
  case $fmt in
    zst) level=3 ;;
    *) level=9 ;;
  esac
fi

case $fmt in
  zst) ext=tar.zst; tool=zstd ;;
  gz) ext=tar.gz; tool=gzip ;;
  xz) ext=tar.xz; tool=xz ;;
  bz2) ext=tar.bz2; tool=bzip2 ;;
  none) ext=tar; tool= ;;
  *) die "unknown compression format: $fmt" ;;
esac
if [[ -n $tool ]]; then
  command -v "$tool" >/dev/null || die "$tool is not installed"
fi
[[ $level =~ ^[1-9]$ ]] || die "level must be 1-9"

members=()
for f in "$@"; do
  [[ -e $f ]] || die "no such file or directory: $f"
  parent=$(dirname -- "$f")
  base=$(basename -- "$f")
  [[ $base == -* ]] && base="./$base"
  members+=(-C "$parent" "$base")
done

if [[ -z $name ]]; then
  name=${1%/}
  name=${name##*/}
fi
name=${name//[^A-Za-z0-9._-]/_}
[[ -n $name ]] || name=archive

stamp=$(date +%F_%H-%M)
out="$dir/quicktar-$name-$stamp.$ext"

limit=$((500 * 1024 * 1024))
total=$(du -sbc -- "$@" | tail -n 1 | cut -f1)
if [[ $verbose -eq 0 && $total -ge $limit ]]; then
  verbose=1
  echo "Inputs are over 500 MiB, listing files as they are archived"
fi

tar_args=(-cpf "$out" --exclude-vcs)
if [[ -n $tool ]]; then
  tar_args+=(-I "$tool -$level")
fi
if [[ $verbose -eq 1 ]]; then
  tar_args+=(-v)
fi
for x in "${excludes[@]}"; do
  tar_args+=("--exclude=$x")
done

if [[ $dryrun -eq 1 ]]; then
  echo "Would run: tar ${tar_args[*]} ${members[*]}"
  exit 0
fi

mkdir -p -- "$dir"
if ! tar "${tar_args[@]}" "${members[@]}"; then
  rm -f -- "$out"
  die "tar failed"
fi

base=${out##*/}
if [[ $checksum -eq 1 ]]; then
  (cd -- "$dir" && sha256sum -- "$base" > "$base.sha256")
fi

count=$(tar -tvf "$out" | awk '/^-/ { n++ } END { print n + 0 }')
size=$(stat -c %s -- "$out")
color=0
if [[ -t 1 ]]; then
  color=1
fi
human=$(awk -v b="$size" -v color="$color" 'BEGIN {
  k = 1024
  if (b >= k^5 * 0.98)      { v = b / k^5; u = "P"; c = 167 }
  else if (b >= k^4 * 0.98) { v = b / k^4; u = "T"; c = 105 }
  else if (b >= k^3 * 0.98) { v = b / k^3; u = "G"; c = 45 }
  else if (b >= k^2 * 0.98) { v = b / k^2; u = "M"; c = 47 }
  else if (b >= k)          { v = b / k;   u = "K"; c = 226 }
  else                      { v = b;       u = "B"; c = 160 }
  if (color) printf "\033[38;5;%dm", c
  if (u == "B") printf "%dB", v
  else printf "%.1f%s", v, u
  if (color) printf "\033[0m"
}')

if [[ $color -eq 1 ]]; then
  count=$'\033[1m\033[97m'"$count files"$'\033[0m'
else
  count="$count files"
fi
echo "$count, $human"
echo "Wrote: $(realpath -- "$out")"

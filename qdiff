#!/usr/bin/env bash
# qdiff - diff a file or directory against its most recent qfb/qtar archive
# Date: 2026-11-11
# Version: v0.1.1
# Purpose: find the newest qfb (file) or qtar (directory) archive matching PATH
#          and show differences between the archived contents and the current PATH.
set -euo pipefail

prog=${0##*/}

usage() {
  cat <<EOF
Usage: $prog [options] PATH

Find the most recent archive of PATH and compare it with the current contents:
  - a regular file is compared with its qfb archive (unified diff)
  - a directory is compared recursively with its qtar archive
    (full unified diff; use -s to list only the differing names)

Options:
  -d DIR      directory to search for archives (default: /var/tmp)
  -s          for directories, list only the names of differing files
  -u          full unified diff for directories (default; accepted for compatibility)
  -c          always colorize diff output (default: only when stdout is a terminal)
  -h          show this help
EOF
}

die() {
  echo "$prog: $*" >&2
  exit 1
}

dir=/var/tmp
full=1
color=auto

while getopts ":d:such" opt; do
  case $opt in
    d) dir=$OPTARG ;;
    s) full=0 ;;
    u) full=1 ;;
    c) color=always ;;
    h) usage; exit 0 ;;
    :) die "option -$OPTARG requires an argument" ;;
    *) die "unknown option -$OPTARG (see -h)" ;;
  esac
done
shift $((OPTIND - 1))

[[ $# -eq 1 ]] || { usage >&2; exit 1; }
path=$1

if [[ -d $path ]]; then
  kind=dir
  prefix=quicktar
  exts="tar.zst tar.gz tar.xz tar.bz2 tar"
elif [[ -f $path ]]; then
  kind=file
  prefix=quickfile
  exts="gz xz zst"
else
  die "not a file or directory: $path"
fi

name=${path%/}
name=${name##*/}
[[ $name != . && $name != .. && -n $name ]] || die "cannot determine archive name for: $path"
name=${name//[^A-Za-z0-9._-]/_}

stamp_re='^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{2}-[0-9]{2}$'
candidates=()
for ext in $exts; do
  for archive in "$dir/$prefix-$name-"*.$ext; do
    [[ -f $archive ]] || continue
    stamp=${archive##*/$prefix-$name-}
    stamp=${stamp%.$ext}
    [[ $stamp =~ $stamp_re ]] || continue
    candidates+=("$stamp|$ext|$archive")
  done
done

[[ ${#candidates[@]} -gt 0 ]] || die "no $prefix archive found for $path in $dir"

newest=$(printf '%s\n' "${candidates[@]}" | sort -r | head -n 1)
ext=$(cut -d'|' -f2 <<< "$newest")
archive=$(cut -d'|' -f3- <<< "$newest")

case $ext in
  gz|tar.gz) dec=(gzip -dc) ;;
  xz|tar.xz) dec=(xz -dc) ;;
  zst|tar.zst) dec=(zstd -dqc) ;;
  tar.bz2) dec=(bzip2 -dc) ;;
  tar) dec=(cat) ;;
esac
command -v "${dec[0]}" >/dev/null || die "${dec[0]} is not installed"

tmproot=/tmp/opencode
[[ -d $tmproot ]] || tmproot=${TMPDIR:-/tmp}
tmp=$(mktemp -d "$tmproot/qdiff.XXXXXX")
trap 'rm -rf -- "$tmp"' EXIT

echo "Comparing $path with $archive"

status=0
if [[ $kind == file ]]; then
  "${dec[@]}" -- "$archive" > "$tmp/$name" || die "failed to decompress: $archive"
  diff -u --color=$color --label "$archive" --label "$path" -- "$tmp/$name" "$path" || status=$?
else
  "${dec[@]}" -- "$archive" | tar -xf - -C "$tmp" || die "failed to extract: $archive"
  [[ -d $tmp/$name ]] || die "archive does not contain $name/: $archive"
  if [[ $full -eq 1 ]]; then
    diff -ruN --color=$color -- "$tmp/$name" "$path" || status=$?
  else
    diff -rq -- "$tmp/$name" "$path" || status=$?
  fi
fi

if [[ $status -eq 0 ]]; then
  echo "$path matches $archive"
fi
exit "$status"
